{
  "name": "@bestfulfill/bshopify",
  "version": "0.1.0",
  "description": "BestFulfill Shopify App Runner CLI.",
  "type": "module",
  "bin": {
    "bshopify": "./dist/cli.js"
  },
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "registry": "https://packages.aliyun.com/686b883471b943e5958efa4c/npm/npm-registry/"
  },
  "scripts": {
    "build": "tsup && chmod +x dist/cli.js",
    "check": "npm run typecheck && npm run test && npm run build",
    "dev": "tsx src/cli.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run check"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@inquirer/prompts": "^7.6.0",
    "commander": "^14.0.0",
    "execa": "^9.6.0",
    "fast-glob": "^3.3.3",
    "smol-toml": "^1.4.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "tsup": "^8.5.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
